{
  "name": "x402-three-layer-agent-payments",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "x402 agent payments with three-layer separation of payment authority (PoC)",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/portal/tsconfig.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run demo:local",
    "demo:local": "tsx scripts/demo-local.ts",
    "stack:local": "tsx scripts/stack-local.ts",
    "demo:base-sepolia": "tsx scripts/demo-base-sepolia.ts",
    "local:chain": "tsx scripts/local-chain.ts",
    "facilitator": "tsx scripts/facilitator.ts",
    "seller": "tsx src/counterparty/seller.ts",
    "l2:control": "tsx src/layer2-control/service.ts",
    "l3:verifier": "tsx src/layer3-settlement/service.ts",
    "agent": "tsx src/main.ts",
    "agent:scripted": "tsx src/main.ts --scripted",
    "approve": "tsx scripts/approve.ts",
    "reject": "tsx scripts/reject.ts",
    "escalations": "tsx scripts/escalations.ts",
    "agent:hosted": "tsx src/hosted-main.ts",
    "portal": "tsx src/portal-main.ts",
    "build:web": "vite build --config web/portal/vite.config.ts",
    "fund-user": "tsx scripts/fund-user.ts",
    "wallet-mnemonic": "tsx scripts/wallet-mnemonic.ts",
    "dev-token": "tsx scripts/dev-token.ts",
    "ledger-verify": "tsx scripts/ledger-verify.ts",
    "payer-balance": "tsx scripts/payer-balance.ts",
    "scan-logs": "tsx scripts/scan-logs.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "3.0.128",
    "@anthropic-ai/sdk": "^0.135.0",
    "@azure/identity": "^4.13.3",
    "@coinbase/cdp-sdk": "1.59.0",
    "@mastra/core": "1.75.0",
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "@x402/express": "2.28.0",
    "dotenv": "^18.0.0",
    "express": "^5.3.0",
    "express-rate-limit": "8.7.1",
    "jose": "^6.2.12",
    "swagger-ui-dist": "5.33.1",
    "viem": "^2.57.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^3.0.18",
    "@auth0/auth0-spa-js": "2.30.0",
    "@azure/bicep-rpc-client": "^0.4.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ai": "^6.0.302",
    "axe-core": "^4.14.0",
    "esbuild": "0.28.2",
    "ganache": "7.9.2",
    "jsdom": "^31.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "solc": "0.8.24",
    "tsx": "^4.23.0",
    "typescript": "^7.0.0",
    "vite": "^8.3.7",
    "vitest": "^5.0.0",
    "yaml": "^2.9.1"
  },
  "scarfSettings": {
    "enabled": false
  }
}
