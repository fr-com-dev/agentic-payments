{
  // Tasks for the local launch configurations (.vscode/launch.json) and the usual checks. Everything runs in local
  // mode; scripts/vscode-local.ts describes the runner.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "local: chain",
      "detail": "Start the local chain (ganache on 8545, MockUSDC, .local/deployment.json), or reuse the one running",
      "type": "process",
      "command": "node",
      "args": ["--import", "tsx", "scripts/vscode-local.ts", "chain"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "local-chain",
        "pattern": { "regexp": "^local chain: error: (.*)$", "file": 2, "message": 1 },
        "background": {
          "activeBegins": true,
          "beginsPattern": "^local chain: checking",
          "endsPattern": "^local chain: (ready|already running|error)"
        }
      },
      "presentation": { "reveal": "silent", "panel": "dedicated", "group": "local" }
    },
    {
      "label": "local: stack",
      "detail": "Make the whole local stack answer: reuse what runs (e.g. the compound \"Local stack\"), start the rest here, not debugged",
      "type": "process",
      "command": "node",
      "args": ["--import", "tsx", "scripts/vscode-local.ts", "stack"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "local-stack",
        "pattern": { "regexp": "^local stack: error: (.*)$", "file": 2, "message": 1 },
        "background": {
          "activeBegins": true,
          "beginsPattern": "^local stack: checking",
          "endsPattern": "^local stack: (ready|already running|error)"
        }
      },
      "presentation": { "reveal": "silent", "panel": "dedicated", "group": "local" }
    },
    {
      "label": "local: stack: users",
      "detail": "The local stack with user accounts on in L2 (013), for the Portal; stop \"local: stack\" first if it runs",
      "type": "process",
      "command": "node",
      "args": ["--import", "tsx", "scripts/vscode-local.ts", "stack", "--users"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "local-stack-users",
        "pattern": { "regexp": "^local stack: error: (.*)$", "file": 2, "message": 1 },
        "background": {
          "activeBegins": true,
          "beginsPattern": "^local stack: checking",
          "endsPattern": "^local stack: (ready|already running|error)"
        }
      },
      "presentation": { "reveal": "silent", "panel": "dedicated", "group": "local" }
    },
    {
      "label": "local: stop stack",
      "detail": "Stop the processes the task \"local: stack\" started",
      "type": "shell",
      "command": "echo local stack stopped ${input:terminateStack}",
      "problemMatcher": [],
      "presentation": { "reveal": "silent" }
    },
    {
      "label": "local: stop stack: users",
      "detail": "Stop the processes the task \"local: stack: users\" started",
      "type": "shell",
      "command": "echo local stack stopped ${input:terminateStackUsers}",
      "problemMatcher": [],
      "presentation": { "reveal": "silent" }
    },
    {
      "label": "local: stop chain",
      "detail": "Stop the local chain started by \"local: chain\"",
      "type": "shell",
      "command": "echo local chain stopped ${input:terminateChain}",
      "problemMatcher": [],
      "presentation": { "reveal": "silent" }
    },
    {
      "label": "local: dev token",
      "detail": "Print a dev-issuer access token for the L1 hosted agent (Swagger UI: Authorize)",
      "type": "process",
      "command": "node",
      "args": ["--import", "tsx", "scripts/dev-token.ts", "--subject", "${input:subject}"],
      "options": { "cwd": "${workspaceFolder}", "env": { "NETWORK": "local" } },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "new" }
    },
    {
      "label": "local: portal token",
      "detail": "Print a dev-issuer access token for the Portal: paste it into its sign-in screen",
      "type": "process",
      "command": "node",
      "args": ["--import", "tsx", "scripts/dev-token.ts", "--subject", "${input:subject}", "--portal"],
      "options": { "cwd": "${workspaceFolder}", "env": { "NETWORK": "local" } },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "new" }
    },
    {
      "label": "build: web",
      "detail": "Build the Portal's web app to dist/portal-web",
      "type": "npm",
      "script": "build:web",
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "typecheck",
      "type": "npm",
      "script": "typecheck",
      "problemMatcher": "$tsc",
      "group": "build"
    },
    {
      "label": "test",
      "detail": "Every suite; stop the local stack and chain first (the e2e suites use the same ports)",
      "type": "npm",
      "script": "test",
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "demo:local",
      "detail": "The 6-process local demo; stop the local stack first",
      "type": "npm",
      "script": "demo:local",
      "problemMatcher": []
    },
    {
      "label": "check",
      "detail": "Definition of done: typecheck, every suite, demo:local; stop the local stack first",
      "type": "npm",
      "script": "check",
      "problemMatcher": [],
      "group": "test"
    }
  ],
  "inputs": [
    { "id": "terminateChain", "type": "command", "command": "workbench.action.tasks.terminate", "args": "local: chain" },
    { "id": "terminateStack", "type": "command", "command": "workbench.action.tasks.terminate", "args": "local: stack" },
    { "id": "terminateStackUsers", "type": "command", "command": "workbench.action.tasks.terminate", "args": "local: stack: users" },
    { "id": "subject", "type": "promptString", "description": "The token's subject (the requester)", "default": "alice" }
  ]
}
