# GitHub setup for the deploy workflows: infra/github-setup.sh reads env/infra.env (quickstart §4 prerequisites).
# Copy this file to env/infra.env and fill it in. Every value is an identifier or a public address. Never put a
# credential here (the payer key, the CDP key, a token): those go only into the Key Vaults, and the script refuses
# any key not listed below.

# The repository, and the GitHub environment the deploy jobs run in. The deploy app's federated credential must
# name both (subject repo:<GITHUB_REPO>:environment:<GITHUB_ENVIRONMENT>).
GITHUB_REPO=fr-com-dev/agentic-payments
GITHUB_ENVIRONMENT=dev

# The deploy app registration's OIDC sign-in.
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=

# The API app's client ID: the AUTH_AUDIENCE infra/entra-app.sh prints (quickstart §4 step 0). Leave it empty
# until then, and run the script again once it is filled in.
AGENT_API_CLIENT_ID=

# Public addresses: the seller's payTo, and the payer the balance check reads (0x and 40 hex digits).
SELLER_PAY_TO=
PAYER_ADDRESS=
