# L3 verifier (src/layer3-settlement/service.ts). Copy to env/l3-verifier.env. Read-only chain access, no keys.
NETWORK=local
# optional; default https://sepolia.base.org
# BASE_SEPOLIA_RPC_URL=
CONTROL_URL=http://127.0.0.1:4020
# local only
VERIFIER_TOKEN=dev-verifier-token
# local only
SETTLEMENT_TOKEN=dev-settlement-token
# optional; default 4023
# SETTLEMENT_PORT=
