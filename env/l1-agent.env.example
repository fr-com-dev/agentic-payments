# L1 agent (src/main.ts). Copy to env/l1-agent.env. Never add PAYER_PRIVATE_KEY here (INV-3).
NETWORK=local
# set me (not needed with --scripted)
ANTHROPIC_API_KEY=
# optional; default claude-sonnet-5-5
# ANTHROPIC_MODEL=
SELLER_URL=http://127.0.0.1:4021
CONTROL_URL=http://127.0.0.1:4020
SETTLEMENT_URL=http://127.0.0.1:4023
# local only
CONTROL_TOKEN=dev-control-token
# local only
VERIFIER_TOKEN=dev-verifier-token
# optional; default sess_<8 hex>
# SESSION_ID=
# optional (L1-4 step 6): a second seller host L2 doesn't allow; default the localhost alias of SELLER_URL
# SELLER_ALIAS_URL=
