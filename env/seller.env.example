# Seller (src/counterparty/seller.ts). Copy to env/seller.env. Holds no on-chain keys and no bearer tokens.
NETWORK=local
# set me: payTo address (local: account #3 from .local/deployment.json)
SELLER_PAY_TO=
# optional: local | public | cdp (default local on local, cdp on base-sepolia)
# FACILITATOR=
# optional; local and public only (rejected with cdp). local default http://127.0.0.1:4022, public default https://x402.org/facilitator
# FACILITATOR_URL=
# set me (FACILITATOR=cdp only): CDP API key ID from cdp.coinbase.com
CDP_API_KEY_ID=
# set me (FACILITATOR=cdp only): CDP API key secret; base64 Ed25519 (recommended) or a quoted PEM EC key
CDP_API_KEY_SECRET=
# optional; default 4021
# SELLER_PORT=
#
# Base Sepolia (CP-3): set NETWORK=base-sepolia and SELLER_PAY_TO to your own address. No local
# facilitator runs. By default the seller verifies and settles through the CDP facilitator
# (https://api.cdp.coinbase.com/platform/v2/x402), which pays gas and needs the CDP API key above.
# The CDP key belongs in this file only (A8). FACILITATOR=public opts out to https://x402.org/facilitator.
# The payer (L2's PAYER_PRIVATE_KEY, in env/l2-control.env only) must hold test USDC
# from https://faucet.circle.com. Base Sepolia USDC's EIP-712 name is "USDC", not "USD Coin".
