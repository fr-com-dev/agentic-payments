# L2 control (src/layer2-control/service.ts). Copy to env/l2-control.env. The only process that holds the payer key.
NETWORK=local
# set me (the local demo derives it from the CP-5 mnemonic when empty)
PAYER_PRIVATE_KEY=
# set me: comma-separated, e.g. the seller payTo address
ALLOWED_PAYEES=
ALLOWED_HOSTS=127.0.0.1:4021
# local only
CONTROL_TOKEN=dev-control-token
# local only
SETTLEMENT_TOKEN=dev-settlement-token
# local only
OPERATOR_TOKEN=dev-operator-token
# optional; default 4020
# CONTROL_PORT=
# optional; 1 also serves Swagger UI at /docs and the OpenAPI document at /openapi.yaml, with no token
# (default off; SEC-13)
# API_DOCS=
