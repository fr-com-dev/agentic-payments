# L2 control (src/layer2-control/service.ts). Copy to env/l2-control.env. The only process that holds the payer key.
NETWORK=local
# set me (the local demo derives it from the CP-5 mnemonic when empty)
PAYER_PRIVATE_KEY=
# set me: comma-separated, e.g. the seller payTo address
ALLOWED_PAYEES=
ALLOWED_HOSTS=127.0.0.1:4021
# local only
CONTROL_TOKEN=dev-control-token
# local only
SETTLEMENT_TOKEN=dev-settlement-token
# local only
OPERATOR_TOKEN=dev-operator-token
# optional, 012 backchannel approval (L2-7); off unless CIBA_APPROVAL=1. Values: specs/012 quickstart §2
# CIBA_APPROVAL=
# CIBA_ISSUER=
# CIBA_CLIENT_ID=
# CIBA_AUDIENCE=
# exactly one of the next two; the key (RSA 2048-4096, PKCS#8 PEM) is preferred
# CIBA_CLIENT_KEY=
# CIBA_CLIENT_SECRET=
# CIBA_CLIENT_KEY_ID=
# optional, 016 sign-in (L2-5): the caller's token. Set all three, or none. Set: every authorize and budget call must
# carry the access token the hosted agent's caller presented (X-Caller-Authorization), L2 verifies it itself and
# takes the user from it. Required with USER_ACCOUNTS=1. The same values as in env/l1-hosted.env; the tenant's are
# Terraform's output l2_env (auth0/). The local dev issuer uses urn:x402:dev-issuer, api://x402-l1-agent and
# x402-agent-cli-dev,x402-agent-desktop-dev (019: the docs page's client and the desktop client, as the agent's list)
# AUTH_ISSUER=
# AUTH_AUDIENCE=
# AGENT_CLIENT_IDS=
# local only, with the dev issuer: its JWKS from `npm run dev-token`
# AUTH_JWKS_FILE=.local/dev-issuer/jwks.json
# the portal's client at the tenant: required with USER_ACCOUNTS=1 (1.19, SEC-35: L2 verifies the person's portal token
# itself, and accepts it only from this client); otherwise only to refuse a start with it on AGENT_CLIENT_IDS (SEC-20).
# local default with --users: x402-portal-dev
# PORTAL_CLIENT_ID=
# optional with USER_ACCOUNTS=1: the sign-in time claim of the person's portal token (default https://x402.dev/auth_time)
# AUTH_TIME_CLAIM=
# optional, 013 user accounts (L2-8); off unless USER_ACCOUNTS=1. Values: specs/013 quickstart §2
# USER_ACCOUNTS=
# the portal's role token (INV-13); must differ from the three tokens above. local default: dev-portal-token
# PORTAL_TOKEN=
# a 24-word BIP-39 mnemonic (`npm run -s wallet-mnemonic`); only the signer reads it. Never change it once users exist
# USER_WALLET_MNEMONIC=
# default config/platform.json (CFG-4)
# PLATFORM_FILE=
# a JSON array that replaces the file's sellers: [{"host":"…","name":"…","payees":["0x…"]}]
# PLATFORM_SELLERS=
# optional; default 4020
# CONTROL_PORT=
# optional; 1 also serves Swagger UI at /docs and the OpenAPI document at /openapi.yaml, with no token
# (default off; SEC-13)
# API_DOCS=
# optional, 014 portal administration (L2-8); off unless PORTAL_ADMIN=1, and it needs USER_ACCOUNTS=1
# PORTAL_ADMIN=
# the administration role's token (INV-13); must differ from every other token. local default: dev-portal-admin-token
# PORTAL_ADMIN_TOKEN=
# optional, 1.19 the ledger's keyed chain (L2-4): off, <secret>, or <entries>:<secret> for an existing ledger of that
# many entries; the secret is hex or base64 of at least 32 bytes. Once the ledger has MACs, L2 needs it to start.
# Never rotate it in place. Default off
# LEDGER_MAC_KEY=
# optional, 1.23 the ledger's head outside the share (L2-4): https://<account>.blob.<suffix>/<container> (Azure: a
# blob only the head identity may write, with that identity's client ID below) or file:///<directory> (local runs).
# Once a head exists, L2 refuses a ledger shorter than it. Unset: no head
# LEDGER_HEAD_URL=
# LEDGER_HEAD_CLIENT_ID=
