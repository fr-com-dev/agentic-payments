# L2 control (src/layer2-control/service.ts). Copy to env/l2-control.env. The only process that holds the payer key.
NETWORK=local
# set me (the local demo derives it from the CP-5 mnemonic when empty)
PAYER_PRIVATE_KEY=
# set me: comma-separated, e.g. the seller payTo address
ALLOWED_PAYEES=
ALLOWED_HOSTS=127.0.0.1:4021
# local only
CONTROL_TOKEN=dev-control-token
# local only
SETTLEMENT_TOKEN=dev-settlement-token
# local only
OPERATOR_TOKEN=dev-operator-token
# optional, 012 backchannel approval (L2-7); off unless CIBA_APPROVAL=1. Values: specs/012 quickstart §2
# CIBA_APPROVAL=
# CIBA_ISSUER=
# CIBA_CLIENT_ID=
# CIBA_AUDIENCE=
# CIBA_APPROVER=
# exactly one of the next two; the key (RSA 2048-4096, PKCS#8 PEM) is preferred
# CIBA_CLIENT_KEY=
# CIBA_CLIENT_SECRET=
# CIBA_CLIENT_KEY_ID=
# optional, 013 user accounts (L2-8); off unless USER_ACCOUNTS=1. Values: specs/013 quickstart §2
# USER_ACCOUNTS=
# the portal's role token (INV-13); must differ from the three tokens above. local default: dev-portal-token
# PORTAL_TOKEN=
# a 24-word BIP-39 mnemonic (`npm run -s wallet-mnemonic`); only the signer reads it. Never change it once users exist
# USER_WALLET_MNEMONIC=
# default config/platform.json (CFG-4)
# PLATFORM_FILE=
# a JSON array that replaces the file's sellers: [{"host":"…","name":"…","payees":["0x…"]}]
# PLATFORM_SELLERS=
# optional; default 4020
# CONTROL_PORT=
# optional; 1 also serves Swagger UI at /docs and the OpenAPI document at /openapi.yaml, with no token
# (default off; SEC-13)
# API_DOCS=
# optional, 014 portal administration (L2-8); off unless PORTAL_ADMIN=1, and it needs USER_ACCOUNTS=1
# PORTAL_ADMIN=
# the administration role's token (INV-13); must differ from every other token. local default: dev-portal-admin-token
# PORTAL_ADMIN_TOKEN=
