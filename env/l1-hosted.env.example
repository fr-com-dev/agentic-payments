# L1 hosted agent service (src/hosted-main.ts). Copy to env/l1-hosted.env. Never add the payer key here (INV-3).
NETWORK=local
SELLER_URL=http://127.0.0.1:4021
CONTROL_URL=http://127.0.0.1:4020
SETTLEMENT_URL=http://127.0.0.1:4023
# local only
CONTROL_TOKEN=dev-control-token
# local only
VERIFIER_TOKEN=dev-verifier-token
# foundry (managed identity, Azure) or anthropic (API key)
MODEL_PROVIDER=anthropic
# set me (anthropic only; forbidden with foundry)
ANTHROPIC_API_KEY=
# optional; default claude-sonnet-5-5 (allow-list in specs/011 contracts/model-access.md)
# ANTHROPIC_MODEL=
# foundry only: https://<resource>.services.ai.azure.com/anthropic/v1
# FOUNDRY_BASE_URL=
# foundry only: client ID of the agent's user-assigned identity
# AZURE_CLIENT_ID=
# People sign in with Auth0 (specs/013 research R19). The tenant's issuer, https://<domain>/ with the final slash,
# and the API's identifier: the same two as in env/portal.env. The local dev issuer uses urn:x402:dev-issuer and
# api://x402-l1-agent. These two and AGENT_CLIENT_IDS go together: all three, or none (then no person is accepted)
AUTH_ISSUER=urn:x402:dev-issuer
AUTH_AUDIENCE=api://x402-l1-agent
# the tenant's clients whose tokens start runs, comma-separated (the agent CLI's native client). Never the portal's
# client: the service refuses to start with PORTAL_CLIENT_ID on this list (local dev issuer: x402-agent-cli-dev)
AGENT_CLIENT_IDS=x402-agent-cli-dev
# System identities stay with the organization's directory (Microsoft Entra ID): its tenant ID and the API app's
# client ID (Entra v2.0 tokens carry it as aud; pre-deploy.bicep's output prints it). Both, or neither: without
# them no system identity is accepted. The local dev issuer uses `dev` and api://x402-l1-agent-service
AUTH_TENANT_ID=dev
SERVICE_AUDIENCE=api://x402-l1-agent-service
# local only: the dev issuer's JWKS from `npm run dev-token`. Remove it to accept the tenant's and the directory's tokens
AUTH_JWKS_FILE=.local/dev-issuer/jwks.json
# set me: 32+ random bytes, hex or base64 (openssl rand -hex 32)
SESSION_REF_SECRET=
# optional, 013: the portal's client at the tenant, only to refuse a start with it on AGENT_CLIENT_IDS (SEC-20)
# PORTAL_CLIENT_ID=
# optional, read by `npm run user-token` only: the agent CLI's native client at the tenant (device flow)
# AGENT_CLI_CLIENT_ID=
# optional; default 4024
# AGENT_PORT=
# optional; default 127.0.0.1 (containers set 0.0.0.0)
# AGENT_BIND_HOST=
# optional; default 0. How many reverse proxies stand in front (1 behind the Azure ingress): the per-address
# request limit then counts the client's address from X-Forwarded-For. Never set it when nothing is in front.
# TRUSTED_PROXY_HOPS=
# optional: 1 serves Swagger UI at /docs with no token (docs/l1-hosted.openapi.yaml); off by default, never in Azure
# API_DOCS=1
