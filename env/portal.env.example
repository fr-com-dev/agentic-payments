# Portal (src/portal-main.ts, specs/013). Copy to env/portal.env. Never add a payment key here: the portal refuses to
# start if it can see PAYER_PRIVATE_KEY or the user wallet mnemonic.
NETWORK=local
CONTROL_URL=http://127.0.0.1:4020
# local only; the same value L2 verifies
PORTAL_TOKEN=dev-portal-token
# People sign in with Auth0 (specs/013 research R19). The tenant's issuer, https://<domain>/ with the final slash,
# and the API's identifier: the same two as in env/l1-hosted.env. The local dev issuer uses urn:x402:dev-issuer
# and api://x402-l1-agent
AUTH_ISSUER=urn:x402:dev-issuer
AUTH_AUDIENCE=api://x402-l1-agent
# the portal's single-page client at the tenant: the only client whose tokens the portal accepts
# (local dev issuer: x402-portal-dev)
PORTAL_CLIENT_ID=x402-portal-dev
# local only: the dev issuer's JWKS (`npm run dev-token -- --portal`). Remove it to sign in with the tenant
AUTH_JWKS_FILE=.local/dev-issuer/jwks.json
# optional: the access-token claim the tenant's post-login Action sets to the time of the person's last sign-in;
# default https://x402.dev/auth_time
# AUTH_TIME_CLAIM=
# optional; default .local/portal/profiles
# PROFILE_DIR=
# optional; the built web app (`npm run build:web`); default dist/portal-web
# PORTAL_WEB_ROOT=
# optional: `stripe` turns cards on (test mode only); off when unset
# CARD_VAULT=
# with CARD_VAULT=stripe: a restricted test key (rk_test_…) with Customers, Setup Intents and Payment Methods: write
# CARD_VAULT_KEY=
# with CARD_VAULT=stripe: the publishable test key (pk_test_…); public
# CARD_VAULT_PUBLISHABLE_KEY=
# optional: 1 turns the administration area on (for people whose token carries the portal:admin permission; specs/014)
# PORTAL_ADMIN=
# with PORTAL_ADMIN=1; local dev default dev-portal-admin-token; the same value L2 verifies
# PORTAL_ADMIN_TOKEN=
# optional; base-sepolia only
# BASE_SEPOLIA_RPC_URL=
# optional; default 4025
# PORTAL_PORT=
# optional; default 127.0.0.1 (containers set 0.0.0.0)
# PORTAL_BIND_HOST=
# optional; default 0. How many reverse proxies stand in front (1 behind the Azure ingress): the per-address
# request limit then counts the client's address from X-Forwarded-For. Never set it when nothing is in front.
# TRUSTED_PROXY_HOPS=
# optional: 1 serves Swagger UI at /docs with no token (docs/portal.openapi.yaml); off by default, never in Azure
# API_DOCS=
