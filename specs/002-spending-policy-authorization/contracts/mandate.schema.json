{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "config/mandate.json",
  "title": "SpendingMandate (CFG-3)",
  "description": "allowedNetworks/allowedAssets are NOT in this file; they are derived from the active network profile. ALLOWED_PAYEES and ALLOWED_HOSTS env vars (comma-separated) replace allowedPayees/allowedHosts when set. Load-time invariant: autoApproveMaxAtomic < hardCapPerPaymentAtomic <= sessionBudgetAtomic.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mandateId", "expiresAt", "allowedSchemes", "allowedPayees", "allowedHosts",
    "autoApproveMaxAtomic", "hardCapPerPaymentAtomic", "sessionBudgetAtomic",
    "dailyBudgetAtomic", "maxAuthorizationsPerMinute", "maxTimeoutSeconds"
  ],
  "$defs": {
    "atomic": { "type": "string", "pattern": "^[0-9]+$" }
  },
  "properties": {
    "mandateId": { "type": "string", "default": "mandate-poc-001" },
    "expiresAt": { "type": "string", "format": "date-time", "default": "2027-12-31T23:59:59Z" },
    "allowedSchemes": { "type": "array", "items": { "type": "string" }, "default": ["exact"] },
    "allowedPayees": { "type": "array", "items": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" }, "default": [] },
    "allowedHosts": { "type": "array", "items": { "type": "string", "description": "host:port" }, "default": ["127.0.0.1:4021"] },
    "autoApproveMaxAtomic": { "$ref": "#/$defs/atomic", "default": "20000" },
    "hardCapPerPaymentAtomic": { "$ref": "#/$defs/atomic", "default": "100000" },
    "sessionBudgetAtomic": { "$ref": "#/$defs/atomic", "default": "100000" },
    "dailyBudgetAtomic": { "$ref": "#/$defs/atomic", "default": "500000" },
    "maxAuthorizationsPerMinute": { "type": "integer", "minimum": 1, "default": 10 },
    "maxTimeoutSeconds": { "type": "integer", "minimum": 1, "default": 300 }
  }
}
