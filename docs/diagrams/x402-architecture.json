  "cards": [
    {
      "dot": "rose",
      "title": "Payment authority & ledger",
      "items": [
        "L1 and Portal hold no keys; L2 is the sole signer (payer key + user wallet mnemonic)",
        "L2 independently verifies forwarded caller/person JWTs (X-Caller-Authorization, X-Person-Authorization)",
        "Keyed hash-chained JSONL ledger + separate head anchor catch tampering and truncation",
        "L3 is read-only; CONFIRMED is final and NOT_SETTLED requires unused nonce after validBefore"
      ]
    },
    {
      "dot": "cyan",
      "title": "Auth0, Portal & Coinbase (017-020)",
      "items": [
        "Auth0 issues PKCE tokens for portal, docs, and desktop clients (S256 + MFA); Google sign-up has no role",
        "Self-hosted portal behind Caddy front proxy (CIDR allow-list, HSTS, hidden health/docs)",
        "Optional Coinbase balances (020): read-only sealed grants confined to portal (rule A18), never in decisions"
      ]
    },
    {
      "dot": "slate",
      "title": "Settlement & local baseline",
      "items": [
        "Base Sepolia uses CDP facilitator by default (120 s JWT, CDP key in seller only, rule A8; CDP pays gas)",
        "Seller rate-limits priced routes (600 req/min/IP) before calling the facilitator",
        "NETWORK=local runs offline on local facilitator + Ganache (demo:local spends 0.006 USDC)"
      ]
    }
  ]
