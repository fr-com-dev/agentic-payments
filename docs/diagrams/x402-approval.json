  "cards": [
    {
      "dot": "rose",
      "title": "One decision core (INV-12)",
      "items": [
        "Every path copies payee, amount, resource, and session from ESCALATED, never from the decision request",
        "Final states (approved, denied, expired at 300 s) are written inside L2's lock and never reversed",
        "Rejections block (session, resource) at any amount via R15; operator text never reaches L1"
      ]
    },
    {
      "dot": "cyan",
      "title": "Channel safeguards",
      "items": [
        "CIBA (012/015): sent to the escalation's owner only; L2 verifies issuer, signature, owner, and exact payment",
        "Portal admin (014/1.19): L2 verifies X-Person-Authorization, blocks self-approval, and requires fresh MFA",
        "Operator CLI (004/010): OPERATOR_TOKEN only; approvals expire in 600 s (max 3600 s) and pay once"
      ]
    }
