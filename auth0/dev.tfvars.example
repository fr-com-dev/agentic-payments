# Copy to dev.tfvars (gitignored) and fill in. No secret goes in this file: the client secret, if any, is
# TF_VAR_client_secret, and the private half of L2's key goes only into the l2 vault.
environment      = "dev"
tenant_domain    = "x402-dev.us.auth0.com"
api_identifier   = "https://x402-payments/dev"
approver_user_id = "auth0|000000000000000000000000"

credential             = "key"
client_public_key_file = "/absolute/path/outside/the/repository/ciba-client-key.pub.pem"

# Leave these as they are unless another configuration owns the tenant's MFA settings.
manage_guardian = true
guardian_policy = "never"
