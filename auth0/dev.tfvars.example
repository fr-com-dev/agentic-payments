# Copy to dev.tfvars, fill in and commit: provision-auth0.yml reads it. No secret goes in this file: the Management
# API credential and the client secret, if any, are secrets of the GitHub environment auth0-dev, and the private half
# of L2's key goes only into the l2 vault.
environment      = "dev"
tenant_domain    = "x402-dev.us.auth0.com"
api_identifier   = "https://x402-payments/dev"
approver_user_id = "auth0|000000000000000000000000"

# The PUBLIC half of L2's key, committed next to this file (auth0/README.md step 2).
credential             = "key"
client_public_key_file = "ciba-client-key.dev.pub.pem"

# Leave these as they are unless another configuration owns the tenant's MFA settings.
manage_guardian = true
guardian_policy = "never"
